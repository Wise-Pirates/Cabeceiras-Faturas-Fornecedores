              "value": "https://api.businesscentral.dynamics.com/.default"
            }
          ]
        },
        "options": {}
      }
    },
    {
      "id": "f6-003",
      "name": "Preparar Filtro",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ],
      "parameters": {
        "jsCode": "// Data limite: ha 3 dias atras\nconst hoje = new Date();\nconst dataLimite = new Date(hoje.getTime() - 3 * 24 * 60 * 60 * 1000);\nconst dataLimiteStr = dataLimite.toISOString().substring(0, 10);\n\nreturn [{\n  json: {\n    data_limite: dataLimiteStr,\n    data_hoje: hoje.toISOString().substring(0, 10),\n    filtro_odata: `documentType eq 'Order' and orderDate le ${dataLimiteStr}`\n  }\n}];"
      }
    },
    {
      "id": "f6-004",
      "name": "Buscar POs Antigas",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "parameters": {
        "method": "GET",
        "url": "=https://api.businesscentral.dynamics.com/v2.0/f41c8222-df66-449c-93b5-c1879e641cb2/PROD/ODataV4/Company('Jorge%20Brand%C3%A3o%20Gon%C3%A7alves')/workflowPurchaseDocuments?$filter={{ encodeURIComponent($json.filtro_odata) }}&$select=number,documentType,buyFromVendorNumber,payToName,orderDate,expectedReceiptDate,postingDate&$top=200",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Obter Token BC').first().json.access_token }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      }
    },
    {
      "id": "f6-005",
      "name": "Preparar Email",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        300
      ],
      "parameters": {
        "jsCode": "// Constroi tabela HTML com as POs atrasadas\nconst bcResp = $input.first().json;\nconst filtro = $('Preparar Filtro').item.json;\nconst pos = bcResp?.value || [];\n\nif (pos.length === 0) {\n  return [{ json: { enviar: false, count: 0, motivo: 'Nenhuma PO atrasada hoje' } }];\n}\n\n// Ordenar por data (mais antigas primeiro)\npos.sort((a, b) => new Date(a.orderDate) - new Date(b.orderDate));\n\n// Calcular dias em atraso para cada PO\nconst hoje = new Date();\nconst linhas = pos.map(p => {\n  const orderDate = new Date(p.orderDate);\n  const diasAtraso = Math.floor((hoje - orderDate) / (1000 * 60 * 60 * 24));\n  const expected = (p.expectedReceiptDate && !p.expectedReceiptDate.startsWith('0001')) ? p.expectedReceiptDate : '—';\n  return `<tr style=\"border-bottom:1px solid #ddd;\">\n    <td style=\"padding:6px;\">${p.number}</td>\n    <td style=\"padding:6px;\">${p.payToName || p.buyFromVendorNumber}</td>\n    <td style=\"padding:6px;\">${p.orderDate}</td>\n    <td style=\"padding:6px;\">${expected}</td>\n    <td style=\"padding:6px;color:${diasAtraso > 7 ? 'red' : 'orange'};font-weight:bold;\">${diasAtraso} dias</td>\n  </tr>`;\n}).join('');\n\nconst html = `<h2>📦 Encomendas em atraso (≥ 3 dias)</h2>\n<p>Data: ${filtro.data_hoje} · ${pos.length} encomenda(s) ainda sem receção/fatura</p>\n<table style=\"border-collapse:collapse;font-family:Arial;width:100%;\">\n  <thead style=\"background:#333;color:#fff;\">\n    <tr>\n      <th style=\"padding:8px;text-align:left;\">Nº PO</th>\n      <th style=\"padding:8px;text-align:left;\">Fornecedor</th>\n      <th style=\"padding:8px;text-align:left;\">Data Encomenda</th>\n      <th style=\"padding:8px;text-align:left;\">Receção Esperada</th>\n      <th style=\"padding:8px;text-align:left;\">Dias em atraso</th>\n    </tr>\n  </thead>\n  <tbody>${linhas}</tbody>\n</table>\n<p style=\"font-size:12px;color:#666;margin-top:20px;\">Email automático gerado pelo sistema de Automação de Faturas Fornecedores.</p>`;\n\nreturn [{\n  json: {\n    enviar: true,\n    count: pos.length,\n    html,\n    pos\n  }\n}];"
      }
    },
