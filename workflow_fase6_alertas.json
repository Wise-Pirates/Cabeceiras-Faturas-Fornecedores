      ],
      "parameters": {
        "method": "POST",
        "url": "https://login.microsoftonline.com/f41c8222-df66-449c-93b5-c1879e641cb2/oauth2/v2.0/token",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "grant_type",
              "value": "client_credentials"
            },
            {
              "name": "client_id",
              "value": "fabec729-bb7e-48f8-a3cc-4a649ed4ab45"
            },
            {
